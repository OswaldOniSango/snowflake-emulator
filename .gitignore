# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
snowflake-emulator
docker

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
go.work.sum

# DuckDB database files created by running the emulator locally
*.db
*.db.wal
*.duckdb

# env file
.env

# Editor/IDE
.idea/
.vscode/

# macOS filesystem metadata
.DS_Store

CLAUDE.md

# Web console.
# The npm project lives in _web/: the leading underscore hides node_modules from
# the Go toolchain, which otherwise compiles Go files shipped inside npm packages.
_web/node_modules/

# Vite's own output directory; scripts/publish-dist.mjs copies it into the Go package
_web/dist/

# Vite output, embedded by server/ui. The placeholder stays tracked so that
# go:embed compiles in a clone where nobody has run the frontend build.
server/ui/dist/*
!server/ui/dist/.gitkeep
